<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.4.6" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <UserSecretsId>udap-dotnet-apphost</UserSecretsId>
    <!-- UdapEd serves HTTPS with the dev cert through Aspire's certificate APIs, still marked experimental. -->
    <NoWarn>$(NoWarn);ASPIRECERTIFICATES001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.4.6" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\migrations\UdapDb.Postgres\UdapDb.Postgres.csproj" />
    <ProjectReference Include="..\Udap.Certificates.Server\Udap.Certificates.Server.csproj" />
    <ProjectReference Include="..\Udap.Auth.Server\Udap.Auth.Server.csproj" />
    <ProjectReference Include="..\Udap.Identity.Provider\Udap.Identity.Provider.csproj" />
    <ProjectReference Include="..\Udap.Identity.Provider.2\Udap.Identity.Provider.2.csproj" />
    <ProjectReference Include="..\FhirLabsApi\FhirLabsApi.csproj" />
    <ProjectReference Include="..\Udap.Proxy.Server\Udap.Proxy.Server.csproj" />
    <ProjectReference Include="..\Tefca.Proxy.Server\Tefca.Proxy.Server.csproj" />
    <ProjectReference Include="..\mTLS.Proxy.Server\mTLS.Proxy.Server.csproj" />
    <ProjectReference Include="..\Udap.Auth.Server.Admin\Udap.Auth.Server.Admin.csproj" />
  </ItemGroup>

</Project>
