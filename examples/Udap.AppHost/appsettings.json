{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  // Persistent containers this AppHost creates, or reuses when one with the same name and spec is already
  // there. Override these in user secrets to share a Postgres and pgAdmin you run for other projects
  // (see examples/README.md). Parameters:postgres-password must then be that container's password.
  "Postgres": {
    "ContainerName": "udap-postgres",
    "DataVolume": "udap-postgres-data",
    "ImageTag": "17.6"
  },
  "PgAdmin": {
    "Enabled": true,
    "ContainerName": "udap-pgadmin",
    "DataVolume": "udap-pgadmin-data",
    "ImageTag": "9.15.0",
    "Port": 5050,
    // pgAdmin's server list, imported when its volume is new. Written here if it does not exist.
    "ServersFile": "~/.udap-dotnet/pgadmin-servers.json"
  },
  // gcloud config folder for udap-proxy's own Google login (the "gcloud-login" resource), apart from the
  // machine's usual gcloud login.
  "UdapProxy": {
    "GcloudConfigDir": "~/.udap-gcloud"
  },
  // The UdapEd test client, run from its published image (pulled again on every start).
  "UdapEd": {
    "Enabled": true,
    "Image": "ghcr.io/joeshook/udaped",
    "ImageTag": "latest",
    "Port": 7041
  }
}
