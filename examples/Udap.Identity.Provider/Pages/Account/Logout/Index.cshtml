@page
@model Udap.Identity.Provider.Pages.Logout.Index
@{
    ViewData["Title"] = "Sign out";
}

<div class="sc-single sc-stack">
    <h1>Sign out of SecuredControls Identity?</h1>
    <p class="sc-lede">Apps that used this sign-in will ask you to sign in again next time.</p>
    <form asp-page="/Account/Logout/Index" class="sc-actions">
        <input type="hidden" name="logoutId" value="@Model.LogoutId" />
        <button class="sc-button">Sign out</button>
        <a class="sc-button sc-button--quiet" href="~/">Stay signed in</a>
    </form>
</div>
