@page
@model Udap.Identity.Provider.Pages.Consent.Index
@{
    ViewData["Title"] = $"Allow {Model.View.ClientName}?";
}

<div class="sc-single sc-stack">
    <div class="sc-stack-sm">
        <h1>Share your identity with @Model.View.ClientName?</h1>
        <p class="sc-lede">Untick anything you don't want to share. Required items are needed to sign you in.</p>
    </div>

    <partial name="_Errors" />

    <form asp-page="/Consent/Index" class="sc-panel sc-stack">
        <input type="hidden" asp-for="Input.ReturnUrl" />

        <div class="sc-labels" role="group" aria-label="How permissions are described" data-labels-toggle hidden>
            <button type="button" data-labels="plain" aria-pressed="true">Plain language</button>
            <button type="button" data-labels="technical" aria-pressed="false">Technical</button>
        </div>

        @if (Model.View.IdentityScopes.Any())
        {
            <fieldset class="sc-stack-sm">
                <legend><h2>About you</h2></legend>
                <partial name="_ScopeList" model="Model.View.IdentityScopes" />
            </fieldset>
        }

        @if (Model.View.ApiScopes.Any())
        {
            <fieldset class="sc-stack-sm">
                <legend><h2>Access</h2></legend>
                <partial name="_ScopeList" model="Model.View.ApiScopes" />
            </fieldset>
        }

        @if (Model.View.AllowRememberConsent)
        {
            <label class="sc-check">
                <input asp-for="Input.RememberConsent" />
                <span>Remember my choice for @Model.View.ClientName</span>
            </label>
        }

        <div class="sc-actions">
            <button class="sc-button" name="Input.button" value="yes" autofocus>Allow</button>
            <button class="sc-button sc-button--quiet" name="Input.button" value="no">Don't allow</button>
        </div>
    </form>

    @if (Model.View.ClientUrl != null)
    {
        <p class="sc-small sc-muted">Learn about this app at <a href="@Model.View.ClientUrl" rel="noopener noreferrer" target="_blank">@Model.View.ClientUrl</a>.</p>
    }
</div>

@section scripts {
    <script type="module" src="~/js/labels.js" asp-append-version="true"></script>
}
