@page
@model Udap.Identity.Provider.Pages.Error.Index
@{
    ViewData["Title"] = "Sign-in problem";
    var error = Model.View?.Error;
}

<div class="sc-single sc-stack">
    <h1>Sign-in didn't work</h1>
    <p class="sc-lede">Go back to the app and try again. If it keeps happening, give the app's developer the details below.</p>
    @if (error != null)
    {
        <dl class="sc-panel sc-facts">
            @if (!string.IsNullOrEmpty(error.Error))
            {
                <div><dt>Error code</dt><dd><code>@error.Error</code></dd></div>
            }
            @if (!string.IsNullOrEmpty(error.ErrorDescription))
            {
                <div><dt>Details</dt><dd>@error.ErrorDescription</dd></div>
            }
            @if (!string.IsNullOrEmpty(error.RequestId))
            {
                <div><dt>Request ID</dt><dd><code>@error.RequestId</code></dd></div>
            }
        </dl>
    }
</div>
