@page
@model Udap.Identity.Provider.Pages.Home.Index
@{
    ViewData["Title"] = "Start";
}

<div class="sc-single sc-stack">
    <div class="sc-stack-sm">
        <h1>SecuredControls Identity</h1>
        <p class="sc-lede">
            A UDAP identity provider. Authorization servers such as SecuredControls Auth send people here to sign in
            through UDAP Tiered OAuth, and register with it dynamically using their UDAP certificates.
        </p>
    </div>

    <div class="sc-actions">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="sc-button sc-button--quiet" href="~/Account/Logout">Sign out</a>
        }
        else
        {
            <a class="sc-button" href="~/Account/Login">Sign in</a>
        }
    </div>

    <section class="sc-panel">
        <h2 class="sc-panel-title">For developers</h2>
        <ul class="sc-stack-sm">
            <li><a href="~/.well-known/udap">UDAP discovery</a></li>
            <li><a href="~/.well-known/openid-configuration">OpenID Connect discovery</a></li>
            <li><a href="~/diagnostics">Claims in your current session</a></li>
            <li><a href="~/grants">Apps you've allowed</a></li>
            <li><a href="https://github.com/JoeShook/udap-dotnet">udap-dotnet on GitHub</a></li>
        </ul>
        <p class="sc-small sc-muted">Duende IdentityServer @Model.Version</p>
    </section>
</div>
