@page
@model Udap.Identity.Provider.Pages.Redirect.IndexModel
@{
    ViewData["Title"] = "Returning to the app";
}

<div class="sc-single sc-stack">
    <h1>Returning you to the app</h1>
    <p class="sc-lede">Once the app opens, you can close this tab.</p>
</div>

<meta http-equiv="refresh" content="0;url=@Model.RedirectUri" data-url="@Model.RedirectUri">

@section scripts {
    <script src="~/js/signin-redirect.js"></script>
}
