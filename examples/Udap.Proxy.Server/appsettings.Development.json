{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        //"Microsoft.AspNetCore.Mvc": "Warning",
        //"Microsoft.AspNetCore.Routing": "Warning",
        //"Microsoft.AspNetCore.Hosting": "Warning",
        "Udap.Proxy.Server.RouteLoggingMiddleware": "Verbose",
        "Yarp": "Verbose"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },

  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {

      "gFhirLab-route": {
        "ClusterId": "gFhirLab-cluster",
        //NOTE:: udapPolicy means this endpoint is protected by UDAP
        "AuthorizationPolicy": "udapPolicy",
        "Match": {

          "Path": "/fhir/r4/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/fhir/{**remainder}"
          }
        ]
      },

      "gFhirLab-route-base-secured": {
        "ClusterId": "gFhirLab-cluster",
        "AuthorizationPolicy": "udapPolicy",        
        "Match": {
          "Path": "/fhir/r4",
          "Methods": [ "POST", "DELETE", "PUT", "PATCH" ]
        },
        "Transforms": [
          {
            "PathSet": "/fhir"
          }
        ]
      },



      "gFhirLab-route-base": {
        "ClusterId": "gFhirLab-cluster",
        "Match": {
          "Path": "/fhir/r4"
        },
        "Transforms": [
          {
            "PathSet": "/"
          }
        ]
      },
      "gFhirLab-route-metadata": {
        "ClusterId": "gFhirLab-cluster",
        "Match": {
          "Path": "/fhir/r4/metadata"
        },
        "Transforms": [
          {
            "PathSet": "/fhir/metadata"
          }
        ]
      }

    },

    "Clusters": {

      "gFhirLab-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://healthcare.googleapis.com/v1beta1/projects/udap-idp/locations/us-west1/datasets/gFhirLab/fhirStores/fhirlabs_open"
          }
        }
      }
    }
  },


  "Jwt": {
    "Authority": "https://udap-auth-server.dev.localhost:5002",
    "RequireHttpsMetadata": true,
    "Token": "https://udap-auth-server.dev.localhost:5002/connect/token",
    "Authorize": "https://udap-auth-server.dev.localhost:5002/connect/authorize",
    "Register": "https://udap-auth-server.dev.localhost:5002/connect/register",
    "Manage": "https://udap-auth-server.dev.localhost:5002/grants"
  },

  "FhirUrlProxy": {
    "Back": "https://healthcare.googleapis.com/v1beta1/projects/udap-idp/locations/us-west1/datasets/gFhirLab/fhirStores/fhirlabs_open/fhir",
    "Front": "https://udap-proxy.dev.localhost:7074/fhir/r4"
  },

  "UdapMetadataOptionsFile": "udap.proxy.server.metadata.options.json",

  "UdapFileCertStoreManifest": {
    "Communities": [

      {
        "Name": "udap://fhirlabs1/",
        "IssuedCerts": [
          {
            // Local base URL https://udap-proxy.dev.localhost:7074/fhir/r4, chained to the localhost community 1
            // anchor (caLocalhostCert). From the PKI generator's MakeUdapProxyLocalhostCert.
            "FilePath": "CertStore/issued/udapProxyLocalhostCert.pfx",
            "Password": "udap-test"
          },
          {
            "FilePath": "CertStore/issued/fhirlabs.net.one.client.pfx",
            "Password": "udap-test"
          },
          {
            "FilePath": "CertStore/issued/fhirlabs.net.two.client.pfx",
            "Password": "udap-test"
          },
          {
            "FilePath": "CertStore/issued/fhirlabs.net.three.client.pfx",
            "Password": "udap-test"
          },
          {
            "FilePath": "CertStore/issued/fhirlabs.net.four.client.pfx",
            "Password": "udap-test"
          },
          {
            "FilePath": "CertStore/issued/fhirlabs.net.five.client.pfx",
            "Password": "udap-test"
          },
          {
            "FilePath": "CertStore/issued/fhirlabs.net.six.client.pfx",
            "Password": "udap-test"
          },
          {
            "FilePath": "CertStore/issued/fhirlabs.net.seven.client.pfx",
            "Password": "udap-test"
          },
          {
            "FilePath": "CertStore/issued/fhirlabs.net.eight.client.pfx",
            "Password": "udap-test"
          },
          {
            "FilePath": "CertStore/issued/fhirlabs.net.nine.client.pfx",
            "Password": "udap-test"
          },
          {
            "FilePath": "CertStore/issued/fhirlabs.net.ten.client.pfx",
            "Password": "udap-test"
          }
        ]
      }
    ]
  },


  "SmartMetadata": {
    "issuer": "https://udap-auth-server.dev.localhost:5002",
    "jwks_uri": "https://udap-auth-server.dev.localhost:5002/.well-known/openid-configuration/jwks",
    "authorization_endpoint": "https://udap-auth-server.dev.localhost:5002/connect/authorize",
    "token_endpoint": "https://udap-auth-server.dev.localhost:5002/connect/token",
    "token_endpoint_auth_methods_supported": [
      "udap_pki_jwt", // inform Smart there is a support for UDAP
      "client_secret_basic",
      "private_key_jwt"
    ],
    "grant_types_supported": [
      "authorization_code",
      "client_credentials",
      "refresh_token"
    ],
    // Should be required when token_endpoint_auth_methods_supported contains udap_pki_jwt
    "registration_endpoint": "https://udap-auth-server.dev.localhost:5002/connect/register",
    "scopes_supported": [ "openid", "profile", "launch", "launch/patient", "patient/*.rs", "user/*.rs", "offline_access" ],
    "response_types_supported": [ "code" ],
    "management_endpoint": "https://udap-proxy.dev.localhost:7074/user/manage", //todo in auth server or EHR?
    "introspection_endpoint": "https://udap-auth-server.dev.localhost:5002/connect/introspect",
    "revocation_endpoint": "https://udap-auth-server.dev.localhost:5002/connect/revoke",
    "code_challenge_methods_supported": [ "S256" ],
    "capabilities": [
      "launch-ehr",
      "permission-patient",
      "permission-v2",
      "client-public",
      "client-confidential-symmetric",
      "context-ehr-patient",
      "sso-openid-connect"
    ]
  },




  "CdsServices": {
    "services": [
      {
        "id": "patient-greeting",
        "title": "Patient greeting",
        "description": "Display which patient the user is currently working with",
        "hook": "patient-view",
        "prefetch": {
          "patient": "Patient/{{context.patientId}}"
        }
      }
    ]
  }


}
