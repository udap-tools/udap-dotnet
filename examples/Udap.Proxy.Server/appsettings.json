{
  "RateLimiting": {
    // Per client IP fixed window limit. Replaces the Cloud Armor throttle rule (500/min per IP).
    // Rejected requests get 429 with Retry-After.
    "Enabled": true,
    "PermitLimit": 500,
    "WindowSeconds": 60,
    // Google's external ALB appends "CLIENT_IP,LB_IP" to X-Forwarded-For. Entries to the left are caller supplied.
    // The client is the entry just left of a LoadBalancerIps match, else the entry TrustedProxyHops from the right.
    "ForwardedForHeader": "X-Forwarded-For",
    "TrustedProxyHops": 1,
    "LoadBalancerIps": [ "107.178.247.107" ],
    "ExemptIps": []
  }
}
